# CrisisMap AI Environment Configuration
# Copy this file to .env and update with your actual values

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=crisismap
CRISIS_COLLECTION=crisis_events
VECTOR_INDEX_NAME=vector_index

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SUMMARIZATION_MODEL=google-t5/t5-small
RESPONSE_MODEL=microsoft/Phi-3-mini-4k-instruct

# Hugging Face API (Optional - for enhanced models)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# OpenAI API (Optional - for advanced LLM features)
OPENAI_API_KEY=your_openai_api_key_here

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/crisismap.log

# Cache Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here
PROMETHEUS_ENABLED=false

# Web Scraping
USER_AGENT=CrisisMap-AI/1.0 (+https://github.com/Mukprojects/CrisisMap_AI)
SCRAPING_DELAY=1.0
MAX_CONCURRENT_REQUESTS=10

# Development Settings
DEBUG=false
RELOAD=false
WORKERS=4

# Grafana Configuration (for monitoring)
GRAFANA_ADMIN_PASSWORD=admin123

# Email Configuration (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@crisismap.ai